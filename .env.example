# Supabase configuration
# Server-side (API routes, service role calls)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Client-side (browser bundle) — must be VITE_-prefixed and match the values above.
# Safe to expose: URL + anon key are public by design, protected by RLS.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Application registration key (required to register new users)
ETB_REGISTRATION_KEY=

# Optional: keep for compatibility (not used with Supabase)
# ETB_JWT_SECRET=
