# Supabase configuration
# Server-side (API routes, service role calls)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Client-side (browser bundle) — must be VITE_-prefixed and match the values above.
# Safe to expose: URL + anon key are public by design, protected by RLS.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Supabase must allowlist this exact recovery redirect URL.
PASSWORD_RECOVERY_REDIRECT_URL=http://localhost:3000/change-password
# Supabase must also allowlist the invitation password-setup redirect URL.
USER_INVITATION_REDIRECT_URL=http://localhost:3000/change-password

# Application registration key (required to register new users)
ETB_REGISTRATION_KEY=

# Optional: keep for compatibility (not used with Supabase)
# ETB_JWT_SECRET=

# HBSS/X-ray integration
HBSS_ADAPTER=mock
HBSS_INTEGRATION_KEY=
HBSS_SOURCE_SYSTEM=MOCK_HBSS
HBSS_SITE_ID=RUH
HBSS_INTEGRATION_ENABLED=false
HBSS_REQUEST_TIMEOUT_MS=10000
HBSS_RECALL_ADAPTER=SIMULATED

# Semantic BHS HTTP integration
BHS_INTEGRATION_KEY=
BHS_SOURCE_SYSTEM=
BHS_SITE_ID=RUH
# Trusted deployment routing context; when set it must match BHS_SITE_ID.
SBTS_SITE_ID=RUH
BHS_INTEGRATION_ENABLED=false
FEATURE_BHS_SIMULATOR=false

# Software-only BHS tagging-station agent. Physical Profinet remains unavailable.
BHS_STATION_ENABLED=false
BHS_STATION_ID=TAG-STATION-01
BHS_STATION_SITE_ID=ALWAJH
BHS_STATION_ALLOWED_LINE_IDS=01
BHS_STATION_SOURCE_SYSTEM=ALWAJH_TAG_STATION_01
BHS_STATION_CENTRAL_URL=http://127.0.0.1:3000
BHS_STATION_CENTRAL_KEY=
BHS_STATION_TRANSPORT=SIMULATED
BHS_STATION_LOCAL_DB_PATH=./var/station/tagging-station.sqlite
BHS_STATION_RETENTION_DAYS=90
BHS_PHYSICAL_MAPPING_STATUS=SIMULATED
BHS_ACK_ENABLED=false
BHS_ACK_RECEIVED_VALUE=1
BHS_ACK_MAPPING_STATUS=PENDING_VENDOR_CONFIRMATION
BHS_ACK_QUEUE_CAPACITY_REACHED=false
BHS_OFFLINE_TAGGING_POLICY=DISABLED

# Phase 3 server-controlled RFID provisioning and bag-photo workflow.
# Physical adapters are fail-closed placeholders until procured vendor contracts are implemented.
TAGGING_PROVISIONING_MODE=PRE_ENCODED_TAG
BAG_PHOTO_POLICY=REQUIRED
RFID_EPC_ALLOWED_BIT_LENGTHS=96,128
RFID_EPC_CANONICAL_CASE=UPPER
RFID_VERIFICATION_REQUIRED_PREENCODED=true
RFID_VERIFICATION_STABLE_READ_COUNT=3
RFID_VERIFICATION_TIMEOUT_MS=5000
RFID_ENCODE_TIMEOUT_MS=15000
TAGGING_SESSION_TTL_SECONDS=1800
BAG_PHOTO_MAX_BYTES=10485760
TAGGING_MANUAL_BARCODE_ENTRY_ENABLED=false
TAGGING_MANUAL_EPC_ENTRY_ENABLED=false
TAGGING_TAG_INVENTORY_ENABLED=false
TAGGING_SIMULATION_ENABLED=false
RFID_TAG_INPUT_ADAPTER=KEYBOARD_WEDGE
RFID_ENCODER_ADAPTER=PHYSICAL_UNAVAILABLE
RFID_VERIFICATION_ADAPTER=PHYSICAL_UNAVAILABLE
BAG_CAMERA_ADAPTER=PHYSICAL_UNAVAILABLE
BAG_PHOTO_STORAGE_ADAPTER=PHYSICAL_UNAVAILABLE
RFID_ENCODER_LOGICAL_DEVICE_ID=RFID-ENCODER-UNCONFIGURED
RFID_VERIFIER_LOGICAL_DEVICE_ID=RFID-VERIFIER-UNCONFIGURED
BAG_CAMERA_LOGICAL_DEVICE_ID=BAG-CAMERA-UNCONFIGURED

# Software-only HBSS recheck-station agent. RS-232 remains unavailable.
HBSS_RECHECK_STATION_ENABLED=false
HBSS_RECHECK_STATION_ID=RECHECK-STATION-01
HBSS_RECHECK_SITE_ID=ALWAJH
HBSS_RECHECK_LOCAL_DB_PATH=./var/station/recheck-station.sqlite
HBSS_SERIAL_ADAPTER=VIRTUAL
HBSS_SERIAL_BINDING=VIRTUAL-HBSS-01
HBSS_BID_FRAMING_PROFILE=STX_BAGID_CRLF
HBSS_BID_MAPPING_STATUS=PENDING_VENDOR_CONFIRMATION
HBSS_SERIAL_ERROR_DIALOG_TIMEOUT_MS=5000
HBSS_SCAN_DEBOUNCE_MS=1000

# Unified software FAT console. Never enable in production.
FEATURE_STATION_FAULT_CONSOLE=false
STATION_FAULT_CONSOLE_DB_PATH=./var/simulation/station-fat.sqlite

# Vendor-neutral screening suspect-event ingestion
# These values are read by server-only modules and must never be VITE_-prefixed.
SCREENING_INTEGRATION_KEY=
SCREENING_SOURCE_SYSTEM=SIMULATED_HBSS

# Reserved for a future vendor adapter
HBSS_BASE_URL=
HBSS_CLIENT_ID=
HBSS_CLIENT_SECRET=


RFID_BURST_WINDOW_MS=1000