# Disposable local/CI PostgreSQL only. Never point this at production.
SBTS_TEST_DATABASE_URL=postgresql://sbts_test:sbts_test@127.0.0.1:55432/sbts_test
# Optional absolute psql path when it is installed but not on PATH.
# SBTS_PSQL_PATH=C:\Program Files\PostgreSQL\17\bin\psql.exe
# Remote targets are refused unless CI=true and this separate flag is true.
SBTS_ALLOW_REMOTE_TEST_DATABASE=false
SBTS_REQUIRE_POSTGRES_TESTS=true
